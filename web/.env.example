# Server-only values. Never add NEXT_PUBLIC_ prefixes to these credentials.
NEON_DATABASE_URL=postgresql://writer:REPLACE@HOST/DATABASE?sslmode=require
NEON_WRITE_DATABASE_URL=postgresql://f1_app_write_login:REPLACE@HOST/DATABASE?sslmode=require
NEON_READ_DATABASE_URL=postgresql://f1_web_read_login:REPLACE@HOST/DATABASE?sslmode=require
# Optional: dedicated role for the rate-limit function. Falls back to writer.
NEON_OPERATIONS_DATABASE_URL=
INGEST_KEY=REPLACE_WITH_RANDOM_SECRET
RATE_LIMIT_SALT=REPLACE_WITH_SEPARATE_RANDOM_SECRET
# Optional HTML enrichment is off unless explicitly enabled.
ENABLE_HTML_INGEST=0
